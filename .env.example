# LeetCode session cookie. In your browser (logged into leetcode.com), open
# DevTools -> Application -> Cookies -> https://leetcode.com -> LEETCODE_SESSION.
# Copy the full value here.
LEETCODE_SESSION=your_leetcode_session_cookie_here

# Optional explicit CSRF cookie. The client attempts to fetch it automatically.
# If needed, copy the "csrftoken" cookie from the same browser session.
# REST submissions need this cookie and a matching x-csrftoken header.
LEETCODE_CSRFTOKEN=

# OPTIONAL: Cloudflare clearance cookie. If submissions keep failing with
# "Just a moment" (HTTP 403), get this from your browser:
#   1. Open leetcode.com in Chrome/Edge on THIS network, wait for any
#      "Checking your browser" screen to pass.
#   2. F12 -> Application -> Cookies -> copy the cf_clearance value.
#   3. F12 -> Console -> run: navigator.userAgent -> copy that string into
#      USER_AGENT below (must match the browser that got the cookie).
CF_CLEARANCE=
USER_AGENT=

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional overrides ---
# Gemini model fallback chain (comma-separated). When one model's free-tier
# daily quota is exhausted, the agent automatically switches to the next.
# Configure model names available to your API key; availability and quotas vary.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview

# Submission language slug used by LeetCode (default: python3)
LEETCODE_LANG=python3

# Path to the SQLite state database (default: ./state.db)
DB_PATH=./state.db

# Min/max seconds of randomized human-like delay between steps.
# LeetCode throttles rapid submissions (HTTP 429) and Cloudflare may trigger
# bot challenges (HTTP 403). Pacing reduces request frequency but does not
# guarantee that requests stay below service limits.
MIN_DELAY=10
MAX_DELAY=20

# Max problems to attempt per run (0 = unlimited). Default: 0
MAX_PROBLEMS=0
